{
  "name": "@sherrbyte/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm db:migrate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "tsx scripts/local-db.ts up",
    "db:down": "tsx scripts/local-db.ts down",
    "db:bootstrap": "tsx scripts/bootstrap-roles.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/local-db.ts reset && pnpm db:bootstrap && pnpm db:migrate && pnpm db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:no-float": "tsx scripts/check-no-float.ts",
    "e2e:check": "tsx --conditions=react-server scripts/e2e-check.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.34.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^10.12.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.44.5",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "jsdom": "^30.1.1",
    "pdfjs-dist": "^6.3.289",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
