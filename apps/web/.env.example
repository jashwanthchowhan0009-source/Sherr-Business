# ─── Database ────────────────────────────────────────────────────────────────
# TWO roles on purpose. A table's owner bypasses RLS, so the runtime must never
# connect as the owner. scripts/bootstrap-roles.ts creates sherrbyte_app.

# Owner role. Migrations and seed ONLY. Never used at runtime.
DATABASE_URL_OWNER="postgresql://owner:password@host/sherrbyte?sslmode=require"

# Application role: owns nothing, has no BYPASSRLS, holds only DML grants.
DATABASE_URL="postgresql://sherrbyte_app:password@host/sherrbyte?sslmode=require"

# ─── Clerk ───────────────────────────────────────────────────────────────────
# Dashboard setup steps are in README.md § Clerk configuration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ─── Observability (optional; inert when unset) ──────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
